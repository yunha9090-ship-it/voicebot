.spin{width:36px;height:36px;border-radius:50%;border:4px solid #E3E7FB;border-top-color:#2F4BD8;animation:sp 0.8s linear infinite}
@keyframes sp{to{transform:rotate(360deg)}}
.toast{position:fixed;left:50%;bottom:24px;transform:translateX(-50%);background:#17181C;color:#fff;padding:12px 18px;border-radius:10px;font-size:14px;z-index:30;box-shadow:0 6px 24px rgba(0,0,0,.2)}
</style>
