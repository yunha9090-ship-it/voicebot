  if(S.up==='pick'){
    body='<h2>자료 직접 올리기</h2><p class="muted" style="font-size:14px">강의계획서, 공모전 안내문처럼 연결되지 않은 자료를 올리면 같은 방식으로 마감일을 찾아요.</p>'+
     '<label class="drop"><b>여기로 파일을 끌어오거나 눌러서 선택</b><span class="muted" style="font-size:13px">PDF · DOCX · HWP · 이미지 (최대 20MB)</span><input id="file" type="file" style="display:none"></label>'+
     '<button type="button" class="btn" data-up="sample">예시 파일로 해보기 (캡스톤_중간보고_안내.pdf)</button>';
  } else if(S.up==='scan'){
    body='<div style="display:flex;flex-direction:column;align-items:center;gap:14px;padding:32px 0;text-align:center"><div class="spin"></div><b>'+esc(S.upName)+'</b><span class="muted" style="font-size:14px">문서를 읽고 마감일과 할 일을 찾는 중이에요…</span></div>';
  } else {
    body='<div class="row" style="justify-content:space-between"><span class="ai">AI가 찾은 내용 · 저장 전 확인</span><span class="mono muted" style="font-size:12px">신뢰도 91%</span></div>'+
     '<span class="muted" style="font-size:13px">'+esc(S.upName)+'</span>'+
     '<div class="quote"><small>근거 문장 (2쪽)</small>“중간 보고서는 <mark>10월 19일(월) 오후 6시</mark>까지 지도교수에게 PDF로 제출한다.”</div>'+
     '<label class="field">제목<input id="u-title" value="캡스톤 디자인 중간 보고서 제출"></label>'+
     '<div class="row" style="align-items:flex-end"><label class="field" style="flex:1 1 180px">마감<input id="u-due" value="10월 19일 (월) 18:00"></label>'+
     '<label class="field" style="flex:1 1 160px">분류<select id="u-cat"><option>대학교/과제</option><option>공모전/프로젝트</option><option>행정/장학</option><option>기타</option></select></label></div>'+
     '<label class="row" style="font-size:14px"><input id="u-req" type="checkbox" checked style="width:18px;height:18px"> 필수 제출</label>'+
     '<div class="sugg"><b style="font-size:14px">함께 찾은 할 일</b><label class="row" style="font-size:14px"><input id="u-extra" type="checkbox" checked style="width:18px;height:18px"> 지도교수 면담 일정 잡기 <span class="muted" style="font-size:13px">· “보고서 제출 전 1회 면담 권장”</span></label></div>'+
     '<div class="row" style="justify-content:flex-end"><button type="button" class="btn" data-up="cancel">취소</button><button type="button" class="btn-primary" data-up="save">확인하고 저장</button></div>';
  }
  el.innerHTML='<div class="mback"><div class="modal" role="dialog" aria-modal="true" aria-label="직접 업로드">'+
    (S.up!=='scan'&&S.up!=='preview'?'<div class="row" style="justify-content:flex-end;margin-bottom:-12px"><button type="button" class="x" aria-label="닫기" data-up="cancel">×</button></div>':'')+body+'</div></div>';
  var f=document.getElementById('file');
  if(f) f.addEventListener('change',function(){ if(f.files[0]) startScan(f.files[0].name); });
}
function startScan(name){
  set({up:'scan',upName:name});
  setTimeout(function(){ if(S.up==='scan') set({up:'preview'}); },1400);
}
function saveUpload(){
  var title=document.getElementById('u-title').value||'제목 없음';
  var due=document.getElementById('u-due').value;
  var cat=document.getElementById('u-cat').value;
  var req=document.getElementById('u-req').checked;
  var extra=document.getElementById('u-extra').checked;
  if(D.some(function(x){return x.id==='a6';})){ set({up:null}); toast('이미 저장된 자료예요'); return; }
  D.push({id:'a6',d:13,title:title,req:req,srcLabel:'직접 업로드 · PDF',cat:cat,pre:'중간 보고서는 ',hl:'10월 19일(월) 오후 6시',post:'까지 지도교수에게 PDF로 제출한다.',due:due,how:'지도교수 이메일 (PDF)',conf:91,from:S.upName,recv:'10월 6일'});
  D.sort(function(a,b){return a.d-b.d;});
  FILES.unshift({name:S.upName,src:'upload',cat:cat,date:'10.06',sum:'중간 보고서 제출 요건, 면담 권장',d:13});
  S.extra.push({id:'t8',title:title,d:13,origin:'업로드',meta:due});
  if(extra) S.extra.push({id:'t9',title:'지도교수 면담 일정 잡기',d:10,origin:'AI 후보',meta:'보고서 제출 전'});
  set({up:null});
  toast('저장했어요 · 해야 할 일에 '+(extra?2:1)+'건 추가됨');
}
function toast(msg){
  var t=document.getElementById('toast'); t.textContent=msg; t.classList.remove('hidden');
  clearTimeout(toast._t); toast._t=setTimeout(function(){t.classList.add('hidden');},2600);
}

function render(){
  var navEl=document.getElementById('nav');
  if(S.onb){
    navEl.style.display='none';
    document.getElementById('main').innerHTML=onboard();
    document.getElementById('panel').innerHTML='';
    upload();
    return;
  }
  navEl.style.display='';
  renderNav();
  var m=document.getElementById('main');
  m.innerHTML = S.screen==='dash'?dash():S.screen==='files'?files():S.screen==='todo'?todo():S.screen==='search'?search():settings();
  panel();
  upload();
}

document.addEventListener('click',function(e){
  var b=e.target.closest('[data-go],[data-open],[data-close],[data-src],[data-done],[data-conn],[data-alert],[data-scope],[data-sugg],[data-onb],[data-reonb],[data-q],[data-upload],[data-up]');
  if(!b) return;
  var ds=b.dataset;
  if(ds.onb){
    if(ds.onb==='scan'){set({onb:2,scan:0});runScan();}
    else set({onb:0,screen:'dash'});
  }
  else if(ds.reonb) set({onb:1,scan:0,sel:null});
  else if(ds.q){document.getElementById('q').value=ds.q;set({screen:'search',q:ds.q,sel:null,onb:0});}
  else if(ds.upload) set({up:'pick'});
  else if(ds.up){
    if(ds.up==='sample') startScan('캡스톤_중간보고_안내.pdf');
    else if(ds.up==='save') saveUpload();
    else set({up:null});
  }
  else if(ds.go) set({screen:ds.go,sel:null});
  else if(ds.open) set({sel:ds.open});
  else if(ds.close) set({sel:null});
  else if(ds.src) set({src:ds.src});
  else if(ds.done){S.done[ds.done]=!S.done[ds.done];render();}
  else if(ds.conn){S.conn[ds.conn]=!S.conn[ds.conn];render();}
  else if(ds.alert){S.alert[ds.alert]=!S.alert[ds.alert];render();}
  else if(ds.scope) set({scope:ds.scope});
  else if(ds.sugg){var p=ds.sugg.split(':');S.sugg[p[0]]=p[1];render();}
});
document.addEventListener('keydown',function(e){
  if(e.key==='Escape'){ if(S.up&&S.up!=='scan') set({up:null}); else if(S.sel) set({sel:null}); }
  if(e.key==='Enter'&&e.target.id==='q'){ var v=e.target.value.trim(); if(v) set({screen:'search',q:v,sel:null,onb:0}); }
});
render();
</script>
</body>
</html>
