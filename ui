.mback{position:fixed;inset:0;background:rgba(23,24,28,.4);z-index:20;display:flex;align-items:center;justify-content:center;padding:16px}
.modal{background:#fff;border-radius:14px;width:560px;max-width:100%;max-height:calc(100vh - 32px);overflow-y:auto;padding:24px;display:flex;flex-direction:column;gap:16px}
